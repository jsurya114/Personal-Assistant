# ============================================
# Ultron AI — Environment Variables Template
# Copy this file to .env and fill in values
# NEVER put real keys in this file!
# ============================================

# ============================================
# PRIMARY AI KEY (Pick ONE of the options below)
# ============================================

# OPTION A — Groq API Key (100% FREE, Blazing Fast, No Credit Card)
# Get it from: https://console.groq.com/keys
# Your key starts with: gsk_...
GROQ_API_KEY=

# OPTION B — Vercel AI API Key
# Get it from: https://vercel.com/dashboard/settings/tokens
# Your key starts with: vck_...
VERCEL_AI_API_KEY=

# OPTION C — Direct provider keys
OPENAI_API_KEY=              # https://platform.openai.com
ANTHROPIC_API_KEY=           # https://console.anthropic.com (optional fallback)
GEMINI_API_KEY=              # https://ai.google.dev (100% Free at Google AI Studio)

# Which provider to use as primary: groq | openai | claude | gemini (default: groq if key set)
AI_PROVIDER=groq

# ============================================
# Job Search APIs
# ============================================
RAPIDAPI_KEY=                # https://rapidapi.com → search "JSearch"
ADZUNA_APP_ID=               # https://developer.adzuna.com (optional)
ADZUNA_APP_KEY=              # https://developer.adzuna.com (optional)

# ============================================
# Information Services
# ============================================
NEWS_API_KEY=                # https://newsapi.org (free tier)
OPENWEATHER_API_KEY=         # https://openweathermap.org/api (free tier)

# ============================================
# Server Config
# ============================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ============================================
# Database Paths (relative to project root)
# ============================================
DATABASE_PATH=./memory/ultron.db

# ============================================
# Location (for weather)
# ============================================
WEATHER_CITY=Chennai
WEATHER_COUNTRY=IN

# ============================================
# User Config
# ============================================
USER_NAME=Boss
ASSISTANT_NAME=Buddy

# ============================================
# Discord Bot
# ============================================
DISCORD_USER_ID=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ============================================
# WhatsApp Integration (100% Free Sandbox / Twilio)
# ============================================
TWILIO_ACCOUNT_SID=           # https://www.twilio.com/try-twilio (Free tier)
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO_NUMBER=whatsapp:+918281017439

# ============================================
# Gmail Inbox Monitoring (100% Free IMAP)
# ============================================
GMAIL_USER=jayasuryabrocamp@gmail.com
GMAIL_APP_PASSWORD=           # https://myaccount.google.com/apppasswords (Free App Password)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993

